# Продакшн-збірка фронтенда.
#
# ЗНАЧЕННЯ ТУТ — ЛИШЕ ЗАПАСНЕ. Реальна адреса бекенда задається змінною
# оточення REACT_APP_API_URL у налаштуваннях Vercel
# (Settings → Environment Variables), і вона має пріоритет над цим файлом.
# Тому адреса конкретного сервера не лежить у репозиторії.
#
# ПОТОЧНА АРХІТЕКТУРА:
#   фронтенд → Vercel   https://<проєкт>.vercel.app
#   бекенд   → Render   https://<сервіс>.onrender.com
#
# У Vercel треба додати:
#   REACT_APP_API_URL = https://<сервіс>.onrender.com     (без слеша в кінці)
#
# А на боці Render — дозволити цей домен і крос-сайтову куку:
#   PP_ALLOWED_ORIGINS  = https://<проєкт>.vercel.app
#   PP_COOKIE_SAMESITE  = none
#   PP_COOKIE_SECURE    = 1
#
# ЧОМУ ЗНАЧЕННЯ ПОРОЖНЄ, А НЕ localhost. Порожній рядок означає «той самий
# домен, з якого відкрито сайт»: запити підуть відносними шляхами
# (/api/categories). Так у продакшн-бандл ГАРАНТОВАНО не потрапляє
# localhost навіть тоді, коли змінну в Vercel забули додати — сайт просто
# працюватиме на статичному каталозі-фолбеку замість того, щоб стукати
# в комп'ютер відвідувача.
#
# Перевірка в src/store/api/client.js навмисно `=== undefined`, а не `||`:
# порожній рядок — це осмислене значення, і з `||` він помилково
# підмінявся б на localhost.
#
# ── ПОТОЧНА АДРЕСА БЕКЕНДА ──
# Перевірено: /api/health віддає {"status":"ok"}, /api/categories — JSON
# із категоріями, POST /api/auth/login — 200 і куку сесії.
# УВАГА: у назві рівно 17 літер «q». Адреса з 18 літерами не існує —
# Render відповідає на неї 404 із заголовком x-render-routing: no-server.
# Без слеша в кінці: client.js його зрізає, але зайвий символ у git-історії
# лише плутає.
REACT_APP_API_URL=https://qqqqqqqqqqqqqqqqq-pzqd.onrender.com
