# Проєкт зібраний на React 16 і старих 3D-бібліотеках, серед яких є
# несумісні peer-залежності: drei@0.0.25 вимагає react-dom >= 16.13, а в
# package.json зафіксовано react-dom 16.8.6. npm 7+ вважає такий конфлікт
# фатальним, тому чиста установка (npm ci — саме її запускає Vercel, коли
# бачить package-lock.json) падає з ERESOLVE ще до збірки.
#
# legacy-peer-deps повертає поведінку npm 6: peer-залежності не
# нав'язуються, а лише попереджаються. Це рівно та схема, на якій проєкт
# уже працює локально й на якій зібрано package-lock.json.
#
# Файл лежить у репозиторії навмисно: так налаштування діє однаково
# локально, на Vercel і в будь-якому CI, і його не треба дублювати
# кнопками в панелі хостингу.
legacy-peer-deps=true
